<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Builds the XML doc file so every build checks the doc comments.
         Undocumented public members (CS1591) and partly documented
         parameter lists (CS1573) are deliberate, so they don't warn. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

</Project>

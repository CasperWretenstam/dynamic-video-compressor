{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=dvc.db"
  },
  "Storage": {
    "InputDirectory": "Storage/Input",
    "OutputDirectory": "Storage/Output"
  },
  "Encoding": {
    "TwoPass": true,
    "Preset": "slow",
    "DefaultMaxShortSide": 1080,
    "DefaultMaxFps": 30
  },
  "OpenApi": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
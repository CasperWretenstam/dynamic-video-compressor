<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dvc.Desktop.Views.ConfirmDialog"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="20" MaxWidth="440">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{StaticResource ControlSpacing}">
            <Button x:Name="ConfirmButton" Click="OnConfirm" />
            <Button x:Name="CancelButton" Classes="accent" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>

</Window>

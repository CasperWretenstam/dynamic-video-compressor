<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared looks for the app's views, by class name, so a view says what
         an element is and this file decides how it looks. -->

    <!-- The toolbar and status bar along the window's edges. -->
    <Style Selector="Border.bar">
        <Setter Property="Background" Value="{DynamicResource BarBrush}" />
        <Setter Property="Padding" Value="{StaticResource BarPadding}" />
    </Style>

    <!-- A panel along the window's side, such as the settings. -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource BarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <!-- A boxed item, such as a video in the queue. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- A message the user should read before carrying on, such as missing
         ffmpeg or skipped files. -->
    <Style Selector="Border.warning">
        <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- The dashed area shown when the queue is empty. -->
    <Style Selector="Border.dropZone">
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

</Styles>
